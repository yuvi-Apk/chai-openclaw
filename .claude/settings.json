{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun test:*)",
      "Bash(bunx tsc:*)",
      "Bash(bun index.ts --help)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(wc:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Read(~/.yuvi/settings.json)",
      "Edit(~/.yuvi/settings.json)",
      "Write(~/.yuvi/settings.json)",
      "Bash(cat .env*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Read(./node_modules/**)",
      "Read(./bun.lock)",
      "Read(./.yuvi/cache/**)",
      "Read(./.yuvi/sessions/**)",
      "Read(./logs/**)",
      "Read(./dist/**)",
      "Read(./out/**)",
      "Read(./coverage/**)",
      "Read(./**/*.lcov)",
      "Read(./**/*.tgz)",
      "Read(./**/*.tsbuildinfo)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-on-stop.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
