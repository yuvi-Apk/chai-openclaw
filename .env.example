
# ================= Model provider =================
# openai or openrouter
YUVI_LLM=openai

# OpenAI  (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-key
OPENAI_DEFAULT_MODEL=gpt-5-mini
# Model for quick internal steps. Blank = OPENAI_DEFAULT_MODEL
OPENAI_FAST_MODEL=

# OpenRouter  (https://openrouter.ai/keys), used when YUVI_LLM=openrouter
OPENROUTER_API_KEY=""
OPENROUTER_DEFAULT_MODEL="openrouter/free"
# Blank = OPENROUTER_DEFAULT_MODEL
YUVI_MODEL_FAST=

# none, minimal, low, medium, high, xhigh, max, or off. Blank = yuvi chooses
YUVI_REASONING=

# ================= Web search (Chat mode) =================
# auto, duckduckgo or tavily. auto = Tavily if a key is set, else DuckDuckGo
YUVI_SEARCH=auto
TAVILY_API_KEY=

# ================= Chat mode =================
# Blank = the provider's fast / default model
YUVI_CHAT_ROUTER_MODEL=
YUVI_CHAT_MODEL=
YUVI_CHAT_MAX_QUERIES=3
YUVI_CHAT_RESULTS=4
YUVI_CHAT_CONTEXT_TOKENS=2500
YUVI_CHAT_FOLLOWUPS=1
YUVI_CHAT_MAX_CALLS=6
YUVI_CHAT_MAX_TOKENS=30000
YUVI_CHAT_KEEP_TURNS=4
YUVI_CHAT_NEWS_TTL_MIN=10
YUVI_CHAT_STABLE_TTL_MIN=360
YUVI_CHAT_ANSWER_TOKENS=3000
YUVI_CHAT_DEBUG=

# ================= Agent and Plan modes =================
YUVI_CONTEXT_WINDOW=120000
# Set to off to skip that step
YUVI_TRIAGE=
YUVI_SELF_REVIEW=
# Extra skill folders, separated by ;
SKILLS_DIRS=

# ================= Telegram bot (yuvi telegram) =================
TELEGRAM_BOT_TOKEN=123456789:replace-me
# At least 6 characters
YUVI_TELEGRAM_PIN=
# Your numeric Telegram id (ask @yuvi), comma separated
YUVI_TELEGRAM_USERS=
# Blank = the folder yuvi was started in
YUVI_TELEGRAM_WORKSPACE=
# name=path;name=path
YUVI_TELEGRAM_PROJECTS=
YUVI_TELEGRAM_LOCK_MINUTES=

# ================= Developer =================
# 1 = write a log file
YUVI_LOG=
# 1 = show the Echo example mode
YUVI_DEV=
